<?xml version="1.0" encoding="utf-8"?>
<!--  运行日志页，对照 gotify-logs-concept.html 的 section.phone：
      顶栏（app_bar_simple）+ toolbar 区（来源/隐私提示/操作/搜索/级别筛选）+ 日志区 + 底部 footnote。
      日志区不在此处写死内容，由 LogsActivity 解析 LoggerHelper.read() 后填充 RecyclerView。  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/logs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gotify_page_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/app_bar"
        layout="@layout/app_bar_simple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!--  toolbar 区（原型 .toolbar：18px 21px 15px，底部 1px 分隔线）  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gotify_surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gotify_page_padding"
            android:paddingTop="@dimen/gotify_page_padding_top"
            android:paddingEnd="@dimen/gotify_page_padding"
            android:paddingBottom="15dp">

            <!--  日志来源（原型 .source：圆点 + 光环 + 「本机日志」12px 800）  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/gotify_logs_source_dot" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/logs_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/logs_source_local"
                    android:textAppearance="@style/TextAppearance.Gotify.CardTitle" />
            </LinearLayout>

            <!--  隐私提示（原型 .caption：10px / 行高 1.55 / muted）  -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/logs_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingMultiplier="1.55"
                android:text="@string/logs_privacy_caption"
                android:textAppearance="@style/TextAppearance.Gotify.Caption" />

            <!--  操作按钮（原型 .actions：复制完整日志 flex:1 + 清空）  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy_logs"
                    style="@style/Widget.Gotify.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/logs_copy_full"
                    android:textColor="@color/gotify_brand_deep"
                    app:backgroundTint="@color/gotify_brand_soft"
                    app:icon="@drawable/gotify_logs_copy_icon"
                    app:iconPadding="6dp"
                    app:iconTint="@color/gotify_brand_deep" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_logs"
                    style="@style/Widget.Gotify.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/logs_clear"
                    app:icon="@drawable/gotify_logs_delete_icon" />
            </LinearLayout>

            <!--  搜索框（原型 .search：surface_soft / 9px 圆角 / min-height 39px / 16px 放大镜）  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/gotify_logs_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="@dimen/gotify_icon_small"
                    android:layout_height="@dimen/gotify_icon_small"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/gotify_logs_search_icon" />

                <EditText
                    android:id="@+id/search_logs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|start"
                    android:hint="@string/logs_search_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:singleLine="true"
                    android:textColor="@color/gotify_text_primary"
                    android:textColorHint="@color/gotify_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!--  级别筛选（原型 .filter-row：全部 / INFO / WARN / ERROR）  -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/logs_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_all"
                        style="@style/Widget.Gotify.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/logs_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_info"
                        style="@style/Widget.Gotify.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/logs_filter_info" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_warn"
                        style="@style/Widget.Gotify.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/logs_filter_warn" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_error"
                        style="@style/Widget.Gotify.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/logs_filter_error" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/gotify_border"
            android:background="@color/gotify_divider" />
    </LinearLayout>

    <!--  日志区（原型 .log-pane：17px 17px 48px 21px）  -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gotify_surface">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/log_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gotify_page_padding"
            android:paddingTop="17dp"
            android:paddingEnd="17dp"
            android:paddingBottom="@dimen/gotify_page_padding_bottom"
            android:scrollbars="vertical" />

        <!--  空态（原型 .log-empty：44px 14px、12px 行高 1.7、标题 14px）  -->
        <LinearLayout
            android:id="@+id/log_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="44dp"
            android:paddingEnd="14dp"
            android:paddingBottom="44dp"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/log_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/logs_empty_title"
                android:textAppearance="@style/TextAppearance.Gotify.CardTitle"
                android:textSize="14sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/log_empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/logs_empty_body"
                android:textAppearance="@style/TextAppearance.Gotify.Body" />
        </LinearLayout>
    </FrameLayout>

    <!--  底部 footnote（原型 .footnote：surface + 顶部 1px 线 + 10px muted）  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gotify_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/gotify_border"
            android:background="@color/gotify_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/logs_footnote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/logs_footnote"
                android:textAppearance="@style/TextAppearance.Gotify.Caption" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/logs_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Gotify.Caption"
                tools:text="显示 0 / 0 条" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
