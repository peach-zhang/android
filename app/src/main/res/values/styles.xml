<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- colorPrimaryDark 会被 AppBarLayout 用作状态栏底色，取 surface 以贴合原型的浅色顶栏 -->
        <item name="colorPrimaryDark">@color/gotify_surface</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/gotify_page_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Gotify.MaterialAlertDialog</item>
    </style>
    <style name="AppTheme.Nav">
        <item name="colorPrimary">@color/colorNavPrimary</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:navigationBarColor">@color/gotify_surface</item>
        <item name="android:statusBarColor">@color/gotify_surface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="AppTheme.NoActionBar.Login">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
    </style>
    
    <style name="AppTheme.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/gotify_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark" />

    <style name="AppTheme.PopupOverlay" parent="AppTheme" />

    <style name="AppTheme.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--  ============================================================  -->
    <!--  Gotify 设计系统：文字层级（数值取自 concept 原型的 CSS）  -->
    <!--  ============================================================  -->
    <style name="TextAppearance.Gotify.Kicker" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/gotify_text_secondary</item>
    </style>

    <style name="TextAppearance.Gotify.Kicker.Brand">
        <item name="android:textColor">@color/gotify_brand_deep</item>
    </style>

    <style name="TextAppearance.Gotify.TopbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.045</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.HeroTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.045</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.DialogTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <!--  MaterialAlertDialog 标题视图样式(必须提供 layout_width/height)  -->
    <style name="Widget.Gotify.Dialog.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Gotify.DialogTitle</item>
    </style>

    <style name="TextAppearance.Gotify.DrawerTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/gotify_on_brand</item>
    </style>

    <style name="TextAppearance.Gotify.SectionHead" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.CardTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.MessageTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.Body" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.7</item>
        <item name="android:textColor">@color/gotify_text_secondary</item>
    </style>

    <style name="TextAppearance.Gotify.Body.Primary">
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.Body.Strong" parent="TextAppearance.Gotify.Body">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/gotify_text_secondary</item>
    </style>

    <style name="TextAppearance.Gotify.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
        <item name="android:textColor">@color/gotify_text_secondary</item>
    </style>

    <style name="TextAppearance.Gotify.Meta" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gotify_text_secondary</item>
    </style>

    <style name="TextAppearance.Gotify.Meta.Brand">
        <item name="android:textColor">@color/gotify_brand_deep</item>
    </style>

    <style name="TextAppearance.Gotify.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingMultiplier">1.65</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.FieldLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Gotify.PrefTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
    </style>

    <style name="TextAppearance.Gotify.PrefSummary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/gotify_text_secondary</item>
    </style>

    <!--  ============================================================  -->
    <!--  Gotify 设计系统：组件样式  -->
    <!--  ============================================================  -->
    <style name="Widget.Gotify.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Gotify.Button</item>
        <item name="android:textColor">@color/gotify_on_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/gotify_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@color/gotify_button_primary_bg</item>
        <item name="cornerRadius">@dimen/gotify_radius_button</item>
        <item name="rippleColor">@color/gotify_on_brand</item>
        <item name="iconTint">@color/gotify_on_brand</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Gotify.Button.Secondary" parent="Widget.Gotify.Button.Primary">
        <item name="android:textColor">@color/gotify_text_primary</item>
        <item name="backgroundTint">@color/gotify_button_secondary_bg</item>
        <item name="strokeColor">@color/gotify_divider</item>
        <item name="strokeWidth">@dimen/gotify_border</item>
        <item name="rippleColor">@color/gotify_brand</item>
        <item name="iconTint">@color/gotify_text_primary</item>
    </style>

    <style name="Widget.Gotify.Button.Danger" parent="Widget.Gotify.Button.Primary">
        <item name="android:textColor">@color/gotify_danger</item>
        <item name="backgroundTint">@color/gotify_button_danger_bg</item>
        <item name="strokeColor">@color/gotify_danger</item>
        <item name="strokeWidth">@dimen/gotify_border</item>
        <item name="rippleColor">@color/gotify_danger</item>
        <item name="iconTint">@color/gotify_danger</item>
    </style>

    <style name="Widget.Gotify.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Gotify.Button</item>
        <item name="android:textColor">@color/gotify_brand_deep</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/gotify_brand</item>
    </style>

    <style name="Widget.Gotify.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Gotify.Button</item>
        <item name="android:textColor">@color/gotify_chip_text</item>
        <item name="chipBackgroundColor">@color/gotify_chip_bg</item>
        <item name="chipStrokeColor">@color/gotify_chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/gotify_border</item>
        <item name="chipCornerRadius">@dimen/gotify_radius_pill</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="chipSurfaceColor">@color/gotify_surface</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="rippleColor">@color/gotify_brand</item>
    </style>

    <style name="Widget.Gotify.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:minWidth">@dimen/gotify_icon_button</item>
        <item name="android:minHeight">@dimen/gotify_icon_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/gotify_text_primary</item>
    </style>

    <style name="Widget.Gotify.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/gotify_surface</item>
        <item name="strokeColor">@color/gotify_divider</item>
        <item name="strokeWidth">@dimen/gotify_border</item>
        <item name="cardCornerRadius">@dimen/gotify_radius_card</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Gotify.Card.Soft">
        <item name="cardBackgroundColor">@color/gotify_surface_soft</item>
    </style>

    <style name="Widget.Gotify.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">@style/TextAppearance.Gotify.PrefTitle</item>
        <item name="android:textColor">@color/gotify_text_primary</item>
        <item name="trackTint">@color/gotify_switch_track</item>
        <item name="thumbTint">@color/gotify_switch_thumb</item>
    </style>

    <style name="Widget.Gotify.PrefRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/gotify_pref_row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/gotify_bg_pref_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Gotify.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/gotify_radius_dialog</item>
    </style>

    <style name="ThemeOverlay.Gotify.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/gotify_surface</item>
        <item name="colorOnSurface">@color/gotify_text_primary</item>
        <item name="colorPrimary">@color/gotify_brand_filled</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Gotify.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Gotify.Dialog.Title</item>
    </style>

</resources>
