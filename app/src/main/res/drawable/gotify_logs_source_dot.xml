<?xml version="1.0" encoding="utf-8"?>
<!--  日志来源指示点：8dp 实心圆点 + 4dp 光环（原型 .source .dot 的 box-shadow: 0 0 0 4px）  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/gotify_success_soft" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/gotify_success" />
        </shape>
    </item>
</layer-list>
